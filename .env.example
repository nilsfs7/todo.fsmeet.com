# Public origin, no trailing slash. Production: https://todo.fsmeet.com
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Local FSMeet API, including /v1. Production: https://api.fsmeet.dffb.org/v1
FSMEET_API_URL=http://localhost:3000/v1

# Must match a client in the FSMeet backend OAUTH_CLIENTS_JSON.
# PKCE public client (no secret) is enough.
FSMEET_OAUTH_CLIENT_ID=todo
# FSMEET_OAUTH_CLIENT_SECRET=
# FSMEET_OAUTH_SCOPES=openid profile email

# Register this client on the FSMeet API (OAUTH_CLIENTS_JSON):
# {"clientId":"todo","displayName":"Todo","redirectUris":["http://localhost:3003/api/auth/fsmeet/callback","https://todo.fsmeet.com/api/auth/fsmeet/callback"],"allowedScopes":["openid","profile","email"]}

# Required in production. Signs the session cookie.
# openssl rand -hex 32
AUTH_SESSION_SECRET=dev-change-me

# MariaDB from docker compose. On the host the server is port 3308.
DATABASE_URL=mysql://todo:password@127.0.0.1:3308/todo
